{
  "openapi": "3.0.0",
  "info": {"title": "Pet API", "version": "1.0.0"},
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List pets",
        "responses": {
          "200": {"description": "ok"}
        }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create pet",
        "responses": {
          "201": {"description": "created"}
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "summary": "Get pet by id",
        "responses": {
          "200": {"description": "ok"}
        }
      }
    }
  }
}
